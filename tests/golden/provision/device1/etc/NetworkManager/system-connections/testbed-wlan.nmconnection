[connection]
id=testbed-wlan
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=10

[wifi]
mode=infrastructure
ssid=testbed
# Power saving off: it adds tens of milliseconds of wake-up latency to the data plane.
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk=synthetic-passphrase

[ipv4]
method=manual
address1=192.168.0.11/24
never-default=true

[ipv6]
method=disabled
