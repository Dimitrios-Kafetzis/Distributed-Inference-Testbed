{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dimitrios-Kafetzis/Distributed-Inference-Testbed/docs/schemas/config.schema.json",
  "title": "Testbed system configuration (config.yaml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ssh_username": { "type": "string", "minLength": 1 },
    "ssh_key_path": { "type": ["string", "null"] },
    "ssh_password_env": { "type": ["string", "null"] },
    "ssh_connect_timeout_s": { "type": "number", "exclusiveMinimum": 0 },
    "ssh_known_hosts_path": { "type": ["string", "null"] },
    "ssh_trust_new_hosts": { "type": "boolean" },

    "base_ip_prefix": { "type": "string", "pattern": "^(\\d{1,3}\\.){1,3}$" },
    "management_ip_prefix": { "type": ["string", "null"], "pattern": "^(\\d{1,3}\\.){1,3}$" },
    "network_interface": { "type": "string", "minLength": 1 },
    "management_interface": { "type": "string", "minLength": 1 },

    "bs_root": { "type": "string", "minLength": 1 },
    "bs_scripts_dir": { "type": "string", "minLength": 1 },
    "bs_results_dir": { "type": "string", "minLength": 1 },
    "bs_models_dir": { "type": "string", "minLength": 1 },

    "ed_root": { "type": "string", "minLength": 1 },
    "ed_scripts_dir": { "type": ["string", "null"] },
    "ed_models_dir": { "type": ["string", "null"] },
    "ed_data_dir": { "type": ["string", "null"] },
    "ed_results_dir": { "type": ["string", "null"] },

    "bs_computation_capacity": { "type": "number", "exclusiveMinimum": 0 },

    "ntp_offset_threshold_ms": { "type": "number", "exclusiveMinimum": 0 },
    "probe_period_s": { "type": "number", "exclusiveMinimum": 0 },

    "nnpm_host": { "type": "string", "minLength": 1 },
    "nnpm_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "nnpm_basic_auth_env": { "type": ["string", "null"] },
    "map_tiles_url": { "type": "string" },
    "map_offline": { "type": "boolean" },

    "headsplit_repo_url": { "type": "string" },
    "headsplit_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "headsplit_dir": { "type": ["string", "null"] },
    "headsplit_master_port": { "type": "integer", "minimum": 1, "maximum": 65535 },

    "bs_management_interface": { "type": "string", "minLength": 1 },
    "ap_interface": { "type": "string", "minLength": 1 },
    "ap_ssid": { "type": "string", "minLength": 1, "maxLength": 32 },
    "ap_channel": { "type": "integer", "enum": [36, 40, 44, 48, 52, 56, 60, 64, 100, 104, 108, 112, 116, 120, 124, 128, 132, 136, 140, 144, 149, 153, 157, 161] },
    "ap_country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "ap_passphrase_env": { "type": ["string", "null"] },
    "mirror_dir": { "type": "string", "minLength": 1 },
    "mirror_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "mirror_url": { "type": ["string", "null"], "pattern": "^https?://" },
    "ssh_public_key_path": { "type": ["string", "null"] },
    "device_timezone": { "type": "string", "minLength": 1 }
  }
}
